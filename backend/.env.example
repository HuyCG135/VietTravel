PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_viet_tour

JWT_SECRET=
VERIFY_EMAIL_SECRET=
RESET_PASS_SECRET=

FRONTEND_URL=http://localhost:5173

# ===== Tự hủy đơn quá hạn TRẢ NỐT bằng BullMQ/Redis (không bắt buộc, có default) =====
# Đơn chưa cọc KHÔNG tự hết hạn; chỉ đơn đã cọc mới có hạn trả nốt.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# Yêu cầu Redis đang chạy: cd backend && docker compose up -d redis

# Không bắt buộc: SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, SMTP_FROM

# ===== Cloudinary (quản lý ảnh tour — bắt buộc cho tính năng upload ảnh) =====
# Lấy tại Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Không bắt buộc (có default)
# CLOUDINARY_UPLOAD_FOLDER=travel-website
# CLOUDINARY_MAX_FILE_SIZE=5242880
# CLOUDINARY_MAX_FILES=10

# ===== Chatbot / RAG (Ollama — không bắt buộc, có default) =====
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# RAG_MIN_SCORE=0.6
# RAG_TOP_K=8
