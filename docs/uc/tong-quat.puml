@startuml UC_TongQuat_DeXuatTour
' ============================================================
' BIỂU ĐỒ USE CASE TỔNG QUÁT
' Module: Đề xuất tour (bảng tour_requests)
' Nguồn: UC spec UC-KH-01..06 (khách hàng), UC-AD-01..05 (admin)
' Chỉ vẽ các use case ĐÃ triển khai trong mã nguồn.
' ============================================================

left to right direction
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 55
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #1E3A8A
  FontColor #0F172A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #64748B
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #1E3A8A
}

actor "Khách hàng" as KH
actor "Admin /\nNhân viên tour" as AD
actor "Hệ thống AI\n(Ollama)" as AI

rectangle "Hệ thống VietTour\nModule Đề xuất tour" {

  package "Nghiệp vụ khách hàng" {
    usecase "UC-KH-01\nĐề xuất tour\ntheo nhu cầu" as KH01
    usecase "UC-KH-02\nSinh bản nháp\ntour bằng AI" as KH02
    usecase "UC-KH-03\nChỉnh sửa bản nháp\nbằng hội thoại" as KH03
    usecase "UC-KH-04\nGửi đề xuất\ntới admin" as KH04
    usecase "UC-KH-05\nXem danh sách\nđề xuất của tôi" as KH05
    usecase "UC-KH-06\nXem chi tiết đề xuất\nvà phản hồi admin" as KH06
  }

  package "Nghiệp vụ admin" {
    usecase "UC-AD-01\nXem hàng đợi\nđề xuất" as AD01
    usecase "UC-AD-02\nXem chi tiết\nđề xuất" as AD02
    usecase "UC-AD-03\nXử lý đề xuất\ntour" as AD03
    usecase "UC-AD-04\nDuyệt đề xuất" as AD04
    usecase "UC-AD-05\nTừ chối đề xuất\n(kèm lý do)" as AD05
  }
}

' ----- Tác nhân chính -----
KH -- KH01
KH -- KH03
KH -- KH05
KH -- KH06
AD -- AD01
AD -- AD03

' ----- Tác nhân phụ -----
KH02 -- AI

' ----- Quan hệ include / extend -----
KH01 ..> KH02 : <<include>>
KH01 ..> KH04 : <<include>>
KH03 ..> KH02 : <<extend>>
AD03 ..> AD02 : <<include>>
AD04 ..> AD03 : <<extend>>
AD05 ..> AD03 : <<extend>>

@enduml
